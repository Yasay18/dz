<%- include('header', { title: 'Новая заявка' }) %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-7">
    <h1 class="mb-4">Новая заявка</h1>
    <% if (errors && errors.length) { %>
      <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul></div>
    <% } %>
    <div class="card"><div class="card-body">
      <form method="POST" action="/create">
        <div class="mb-3">
          <label class="form-label" for="room_id">Помещение</label>
          <select id="room_id" class="form-select" name="room_id" required>
            <option value="">Выберите помещение</option>
            <% rooms.forEach((room) => { %>
    <option value="<%= room.id %>" <%= String(form?.room_id || '') === String(room.id) ? 'selected' : '' %>><%= room.type %> — <%= room.name %> (вместимость: <%= room.capacity %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label" for="date_start">Дата начала конференции</label>
          <input id="date_start" type="date" class="form-control" name="date_start" min="<%= new Date().toISOString().slice(0, 10) %>" value="<%= form?.date_start || '' %>" required>
        </div>
        <div class="mb-3">
          <label class="form-label" for="payment">Способ оплаты</label>
          <select id="payment" class="form-select" name="payment" required>
            <option value="">Выберите способ оплаты</option>
            <option value="При очном посещении" <%= form?.payment === 'При очном посещении' ? 'selected' : '' %>>При очном посещении</option>
            <option value="Перевод по СБП" <%= form?.payment === 'Перевод по СБП' ? 'selected' : '' %>>Перевод по СБП</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary w-100">Отправить заявку</button>
      </form>
    </div></div>
    <p class="mt-3 text-center"><a href="/dashboard">Вернуться к моим заявкам</a></p>
  </div>
</div>
<%- include('footer') %>

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>

  <h1><%= title %></h1>

  <form action="/login" method="POST">

    <label>Логин:</label>
    <input type="text" name="login" required>

    <br><br>

    <label>Пароль:</label>
    <input type="password" name="password" required>

    <br><br>

    <button type="submit">Войти</button>

  </form>

</body>
</html>
<%- include('header', { title: 'Помещения' }) %>
<h1 class="mb-4">Помещения</h1>
<p class="text-muted">Всего помещений: <b><%= rooms.length %></b></p>
<div class="mb-3 d-flex flex-wrap gap-2">
  <a href="/rooms" class="btn btn-sm btn-outline-primary">Все</a>
  <a href="/rooms/type/Аудитория" class="btn btn-sm btn-outline-primary">Аудитория</a>
  <a href="/rooms/type/Коворкинг" class="btn btn-sm btn-outline-primary">Коворкинг</a>
  <a href="/rooms/type/Кинозал" class="btn btn-sm btn-outline-primary">Кинозал</a>
</div>
<% if (rooms.length === 0) { %>
  <div class="alert alert-info">Помещения не найдены.</div>
<% } %>
<div class="row">
  <% rooms.forEach((room) => { %>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100"><div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <h5 class="card-title mb-1"><%= room.name %></h5>
          <span class="badge bg-info text-dark"><%= room.type %></span>
        </div>
        <p class="text-muted mt-3 mb-0">Вместимость: <b><%= room.capacity %></b></p>
      </div></div>
    </div>
  <% }) %>
</div>
<%- include('footer') %>
